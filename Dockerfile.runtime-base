ARG NODE_IMAGE=node:24-trixie-slim@sha256:0711b541c1c33a8a530ac4f0d391baa9a15b3d804695b1b24a47daa5fb60e74d
FROM ${NODE_IMAGE}

LABEL org.opencontainers.image.title="PaperTrade runtime base"
LABEL org.opencontainers.image.description="Node.js plus PDF/docx/ePub conversion tools for PaperTrade"

ENV NODE_ENV=production

RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    libreoffice-writer \
    calibre \
  && rm -rf /usr/local/lib/node_modules \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
