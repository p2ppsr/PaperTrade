ARG NODE_IMAGE=node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436
FROM ${NODE_IMAGE}

LABEL org.opencontainers.image.title="PaperTrade runtime base"
LABEL org.opencontainers.image.description="Node.js plus PDF/docx/ePub conversion tools for PaperTrade"

ENV NODE_ENV=production

RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    libreoffice-writer \
    calibre \
  && rm -rf /usr/local/lib/node_modules \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
