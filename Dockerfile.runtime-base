ARG NODE_IMAGE=node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea
FROM ${NODE_IMAGE}

LABEL org.opencontainers.image.title="PaperTrade runtime base"
LABEL org.opencontainers.image.description="Node.js plus PDF/docx/ePub conversion tools for PaperTrade"

ENV NODE_ENV=production

RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    libreoffice-writer \
    calibre \
  && rm -rf /usr/local/lib/node_modules \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
